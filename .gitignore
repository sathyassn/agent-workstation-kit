# CodeFlow gate artefacts
target/

# CodeFlow's model-evaluation skill is left out: its eval case IDs start
# with "sk-", which CodeFlow's own pre-commit secret scan refuses. Restore it
# once CodeFlow renames them.
.agents/skills/cf-evaluate-model/
.claude/skills/cf-evaluate-model/
.codeflow/.baseline/.agents/skills/cf-evaluate-model/
.codeflow/.baseline/.claude/skills/cf-evaluate-model/

# codeflow:managed:begin
# secrets, never tracked
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*credentials*

# os / editor
.DS_Store
*.swp

# local-only claude settings and the Claude Code write journal
.claude/settings.local.json
.claude/.cc-writes/

# linked worktree checkouts (not git's .git/worktrees/ metadata)
.worktrees/

# crash-recovery/locking state for opt-in portal reconciliation
.codeflow/.docs-portal.lock
.codeflow/.docs-portal-transaction/
.codeflow/.docs-portal-transaction-stage-*/
# codeflow:managed:end
