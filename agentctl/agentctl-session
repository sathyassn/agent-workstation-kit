#!/usr/bin/env bash

set -Eeuo pipefail

config=/etc/agentctl/target.conf
[[ -r "$config" ]] || { printf 'agentctl-session: missing configuration\n' >&2; exit 1; }
# Root-owned static assignment file generated by the installer.
# shellcheck disable=SC1090
source "$config"
policy=/usr/local/libexec/agentctl-policy
[[ -r "$policy" ]] || { printf 'agentctl-session: missing authorization policy\n' >&2; exit 1; }
# Root-owned file installed beside this helper.
# shellcheck disable=SC1090
source "$policy"

operator=${SUDO_USER:-unknown}
action=${1:-help}

die() {
  printf 'agentctl: %s\n' "$*" >&2
  exit 1
}

valid_session() {
  [[ ${1:-} =~ ^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,63}$ ]]
}

is_operator() {
  agentctl_is_operator "$operator"
}

is_viewer() {
  agentctl_is_viewer "$operator"
}

require_operator() {
  is_operator || die "$operator is not an authorized operator."
}

require_viewer() {
  is_viewer || die "$operator is not authorized for this workspace."
}

log_action() {
  logger -t agentctl "operator=$operator account=$AGENTCTL_ACCOUNT action=$action detail=${1:-none}"
}

target=${2:-}
if [[ "$action" != help && "$action" != list ]]; then
  [[ "$target" == "$AGENTCTL_TARGET" ]] || die "expected target '$AGENTCTL_TARGET'."
fi

# sudo -H sets HOME for the target account. Start every delegated shell and
# session there so a caller cannot strand an agent in a human-owned directory.
agent_home=$(getent passwd "$AGENTCTL_ACCOUNT" | cut -d: -f6)
[[ -n "$agent_home" && -d "$agent_home" ]] || die 'target account has no usable home directory.'
[[ "$HOME" == "$agent_home" ]] || die 'target HOME does not match the configured account.'
cd "$agent_home"

case "$action" in
  help)
    cat <<EOF
Usage:
  agentctl list
  agentctl status $AGENTCTL_TARGET
  agentctl shell $AGENTCTL_TARGET
  agentctl attach $AGENTCTL_TARGET SESSION
  agentctl observe $AGENTCTL_TARGET SESSION
  agentctl start $AGENTCTL_TARGET SESSION {shell|codex|claude|grok}
  agentctl stop $AGENTCTL_TARGET SESSION [--yes]
  agentctl detach                 # run from inside an attached session
EOF
    ;;
  list)
    require_viewer
    printf '%s\t%s\n' "$AGENTCTL_TARGET" "$AGENTCTL_ACCOUNT"
    ;;
  status)
    require_viewer
    log_action status
    printf 'Target:   %s\nAccount:  %s\nOperator: %s\n\nSessions:\n' \
      "$AGENTCTL_TARGET" "$AGENTCTL_ACCOUNT" "$operator"
    tmux list-sessions 2>/dev/null || printf 'No tmux sessions.\n'
    ;;
  shell)
    require_operator
    log_action shell
    printf 'Agent workspace: %s\nHuman operator:  %s\nReturn with:     exit or Ctrl-D\n\n' \
      "$AGENTCTL_ACCOUNT" "$operator"
    export AGENT_OPERATOR="$operator"
    exec /bin/zsh -l
    ;;
  attach|observe)
    require_viewer
    session=${3:-}
    valid_session "$session" || die 'invalid or missing session name.'
    tmux has-session -t "$session" 2>/dev/null || die "session does not exist: $session"
    log_action "$session"
    export AGENT_OPERATOR="$operator"
    if [[ "$action" == observe ]]; then
      exec tmux attach-session -r -t "$session"
    fi
    require_operator
    exec tmux attach-session -t "$session"
    ;;
  start)
    require_operator
    session=${3:-}
    tool=${4:-}
    valid_session "$session" || die 'invalid or missing session name.'
    tmux has-session -t "$session" 2>/dev/null && die "session already exists: $session"
    case "$tool" in
      shell) command=(/bin/zsh -l) ;;
      codex|claude|grok)
        # Use the target account's interactive shell so user-scoped mise shims
        # and vendor-local install paths are available despite sudo secure_path.
        /bin/zsh -ic "command -v $tool >/dev/null" || die "command is not installed: $tool"
        command=(/bin/zsh -ic "exec $tool")
        ;;
      *) die 'tool must be shell, codex, claude, or grok.' ;;
    esac
    log_action "$session:$tool"
    export AGENT_OPERATOR="$operator"
    tmux new-session -d -c "$agent_home" -e "AGENT_OPERATOR=$operator" -s "$session" "${command[@]}"
    printf 'Started %s in session %s. Attach with: agentctl attach %s %s\n' \
      "$tool" "$session" "$AGENTCTL_TARGET" "$session"
    ;;
  stop)
    require_operator
    session=${3:-}
    valid_session "$session" || die 'invalid or missing session name.'
    tmux has-session -t "$session" 2>/dev/null || die "session does not exist: $session"
    if [[ ${4:-} != --yes ]]; then
      [[ -t 0 ]] || die 'refusing non-interactive stop without explicit --yes.'
      printf 'Stop session %s and terminate its processes? Type the session name: ' "$session" >&2
      IFS= read -r confirmation
      [[ "$confirmation" == "$session" ]] || die 'stop cancelled.'
    fi
    log_action "$session"
    tmux kill-session -t "$session"
    ;;
  *) die "unknown action: $action" ;;
esac
