#!/usr/bin/env bash

set -Eeuo pipefail

config=/etc/agentctl/target.conf
helper=/usr/local/libexec/agentctl-session
observer=/usr/local/libexec/agentctl-observe

die() {
  printf 'agentctl: %s\n' "$*" >&2
  exit 1
}

if [[ ${1:-} == detach ]]; then
  [[ -n ${TMUX:-} ]] || die 'detach must be run inside an attached tmux session; otherwise use Ctrl-b d.'
  exec tmux detach-client
fi

[[ -r "$config" ]] || die "missing configuration: $config"
# Root-owned static assignment file generated by the installer.
# shellcheck disable=SC1090
source "$config"
[[ -n ${AGENTCTL_ACCOUNT:-} ]] || die 'AGENTCTL_ACCOUNT is not configured.'

# Set HOME to the target account. The agent CLIs, mise activation, tmux socket,
# and credential helpers all rely on the target home rather than the caller's.
action=${1:-help}
(($# == 0)) || shift
case $action in
  help|list|status|observe)
    exec sudo -H -u "$AGENTCTL_ACCOUNT" -- "$observer" "$action" "$@"
    ;;
  *)
    exec sudo -H -u "$AGENTCTL_ACCOUNT" -- "$helper" "$action" "$@"
    ;;
esac
