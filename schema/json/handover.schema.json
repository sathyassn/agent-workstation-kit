{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sathyassn/agent-workstation-kit/schema/json/handover.schema.json",
  "title": "Human Hand-Over",
  "description": "A structured hand-over block for a gate, root step, revert or proposed change that requires a person.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "machine",
    "account",
    "step",
    "command",
    "why",
    "verify",
    "undo",
    "probe",
    "status"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "machine": {
      "type": "string",
      "minLength": 1
    },
    "account": {
      "type": "string",
      "minLength": 1
    },
    "step": {
      "type": "string",
      "minLength": 1
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "argv",
        "display"
      ],
      "properties": {
        "argv": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "display": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "why": {
      "type": "string",
      "minLength": 1
    },
    "verify": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "argv"
      ],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "undo": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "probe": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/probe"
        }
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "blocked",
        "done"
      ]
    }
  },
  "$defs": {
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "argv"
      ],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "interval_seconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
