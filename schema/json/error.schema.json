{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sathyassn/agent-workstation-kit/schema/json/error.schema.json",
  "title": "CLI Error",
  "description": "Structured CLI error or refusal returned on failure in JSON mode.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "code",
    "class",
    "message"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "code": {
      "type": "integer",
      "enum": [
        1,
        2,
        3,
        4,
        5,
        6,
        130
      ]
    },
    "class": {
      "type": "string",
      "minLength": 1
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "rule": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "if": {
    "required": [
      "class"
    ],
    "properties": {
      "class": {
        "const": "refused"
      }
    }
  },
  "then": {
    "required": [
      "rule"
    ],
    "properties": {
      "rule": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
