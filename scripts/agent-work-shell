#!/usr/bin/env bash
# Start the agent account's login shell inside agent-work.slice, the memory
# ceiling set by apply-resource-policy-linux.sh. Set this file as the agent
# manager's terminal shell so its terminals, and the agents started in them,
# run under the ceiling. Arguments are passed to the shell after -l.
#
# - Already inside agent-work.slice: exec the shell directly.
# - Policy not installed: exec the shell directly.
# - Otherwise: move into a new scope in the slice with systemd-run.

set -euo pipefail

shell=${SHELL:-/bin/bash}
# Never re-run this wrapper as the shell, which would loop.
if [[ "$shell" -ef "${BASH_SOURCE[0]}" || ! -x "$shell" ]]; then
  shell=/bin/bash
fi

if [[ -f /etc/systemd/user/agent-work.slice ]] && ! grep -Fq '/agent-work.slice/' /proc/self/cgroup 2>/dev/null; then
  exec systemd-run --user --scope --quiet --collect --slice=agent-work.slice -- "$shell" -l "$@"
fi
exec "$shell" -l "$@"
