{
  "_description": "Kit gates and Go targets (gofmt, goimports, vet, golangci-lint, go test, govulncheck).",
  "$schema": "test-config.schema.json",
  "schema_version": "1.0",
  "execution": {
    "parallel": false,
    "fail_fast": false
  },
  "defaults": {
    "coverage": []
  },
  "targets": [
    {
      "name": "kit",
      "enabled": true,
      "runner": "custom",
      "modes": {
        "essential": {
          "command": "make check"
        },
        "full": {
          "command": "make ci-check && make public-check"
        }
      }
    },
    {
      "name": "go-format",
      "enabled": true,
      "runner": "custom",
      "modes": {
        "quick": {
          "command": "sh -c 'out=\"$(gofmt -l .)\" || exit 1; if [ -n \"$out\" ]; then printf \"%s\\n\" \"$out\"; exit 1; fi'"
        },
        "essential": {
          "command": "sh -c 'out=\"$(gofmt -l .)\" || exit 1; if [ -n \"$out\" ]; then printf \"%s\\n\" \"$out\"; exit 1; fi'"
        },
        "full": {
          "command": "sh -c 'out=\"$(gofmt -l .)\" || exit 1; if [ -n \"$out\" ]; then printf \"%s\\n\" \"$out\"; exit 1; fi; out=\"$(go tool golangci-lint fmt --diff)\" || exit 1; if [ -n \"$out\" ]; then printf \"%s\\n\" \"$out\"; exit 1; fi'"
        }
      }
    },
    {
      "name": "go-vet",
      "enabled": true,
      "runner": "custom",
      "modes": {
        "quick": {
          "command": "go vet ./..."
        },
        "essential": {
          "command": "go vet ./..."
        },
        "full": {
          "command": "go vet ./..."
        }
      }
    },
    {
      "name": "go-lint",
      "enabled": true,
      "runner": "custom",
      "modes": {
        "full": {
          "command": "go tool golangci-lint run ./..."
        }
      }
    },
    {
      "name": "go-test",
      "enabled": true,
      "runner": "custom",
      "modes": {
        "essential": {
          "command": "make go-check"
        },
        "full": {
          "command": "go mod verify && go test -race ./... && make go-check"
        }
      }
    },
    {
      "name": "go-vuln",
      "enabled": true,
      "runner": "custom",
      "modes": {
        "full": {
          "command": "go tool govulncheck ./..."
        }
      }
    }
  ]
}
